# ==========================================
# 「烽燧」(FengSui / cpe-dash) — H168-383 连接配置
# ==========================================
# 华为 5G CPE Ultra 6 (H168-383) 局域网管理地址（严格限制内网单源 Origin，防 SSRF）
CPE_URL=http://192.168.8.1
# CPE 管理员账号（H168-383 固件 4.4.0.1 默认固定为 admin）
CPE_USERNAME=admin
# CPE 管理后台登录密码（必填；若触发 108006 密码错误将立即触发防爆破断路器熔断）
CPE_PASSWORD=your_cpe_admin_password

# 运行时区（IANA 名称，如 UTC、Europe/Dublin、Asia/Shanghai）：启动时写入进程环境（容器/系统已设置
# TZ 环境变量时以其为准）。请与 CPE 所在时区一致：发出短信的 <Date> 按本地时间生成。
TZ=UTC

# ==========================================
# 🔐 本地落盘加密与 Web 安全配置
# ==========================================
# 用于本地持久化状态、短信镜像、通讯录与 Telegram 状态（data/*.json）的独立主密钥
# 若留空，默认使用 CPE_PASSWORD 经 scrypt + HKDF-SHA256 派生 AES-256-GCM 子密钥加密落盘
# 强烈建议设置独立密钥：通讯录无法从 CPE 重新同步。更换密钥或 CPE_PASSWORD 后请先调用
# POST /api/session/reset-breaker 立即重新加密，再重启；直接重启会把无法解密的文件隔离为 *.unreadable-<时间戳>
DATA_ENCRYPTION_KEY=

# Web 控制台与 REST API 鉴权口令（留空则默认复用 CPE_PASSWORD，采用常量时间摘要比对）
API_TOKEN=
# 可选：只读 Bearer 令牌（看板、脚本、AI 智能体）。可读 REST / SSE、触发只读刷新，/mcp 上只暴露只读工具；
# 任何写操作返回 403 READ_ONLY_TOKEN。必须与 API_TOKEN、CPE_PASSWORD 不同；留空不启用
API_TOKEN_READONLY=

# 受信任反向代理精确 IP 列表（英文逗号分隔，如 127.0.0.1,::1,192.168.8.10；生产中请填写精确反代 IP 而非宽泛容器网段）
# 仅当直连 Socket 对端命中此白名单时才解析 X-Forwarded-For / X-Forwarded-Proto，严防伪造 IP 绕过限流
TRUSTED_PROXIES=127.0.0.1,::1

# 可选：额外允许访问 Web / MCP 的自定义反代域名白名单（防 DNS Rebinding 攻击，如 cpe.example.com）
ALLOWED_HOSTS=

# ==========================================
# 📡「烽燧」Web 监控台与 MCP Server 监听配置
# ==========================================
WEB_ENABLED=true
# 默认高位独立端口 18384（避开群晖 NAS 常用 8080 及 cpe-sms 默认的 18383）
# docker compose 下容器内固定监听 18384，此值决定映射到宿主机的端口
WEB_PORT=18384
WEB_HOST=0.0.0.0
# 默认界面与广播语言（zh-CN 或 en）
DEFAULT_LOCALE=zh-CN
# 是否在统一端口上暴露 Streamable HTTP POST /mcp 接口供内网 AI 智能体调用
MCP_HTTP_ENABLED=true
# 是否允许 MCP 智能体调用写控制类工具（锁频段/锁小区/安全开关/需 confirm:true 的重启）
MCP_ALLOW_MUTATIONS=true
# 是否向 MCP 开放会断网的访问控制工具（拉黑/恢复 Wi-Fi 设备、MAC 黑白名单、上网时段）。默认关闭：
# AI 只能读取访问控制状态。设为 true 后仍受 MCP_ALLOW_MUTATIONS 约束，且每次调用必须带 confirm:true
MCP_ALLOW_ACCESS_CONTROL=false
# cpe-dash mcp（stdio 桥接）转发的守护进程 /mcp 地址；留空时按 WEB_HOST/WEB_PORT 推导为 http://127.0.0.1:18384/mcp
# 只接受局域网/环回主机；桥接自身不连接 CPE，所有工具调用都经守护进程唯一的会话调度器
MCP_DAEMON_URL=
# 跨主机重复守护进程保护：局域网 UDP 广播签名信标（密钥由 CPE_PASSWORD 经 scrypt 派生），第二个管理同一台 CPE 的
# 守护进程自动待机（不访问 CPE、暂停 Telegram）并告警。Docker 桥接网络不转发广播，NAS 上请用 host 网络。
# 信标对局域网所有设备可见，可被用来离线猜测弱路由器密码；只运行一台守护进程时可设为 false
PEER_DISCOVERY_ENABLED=true
PEER_DISCOVERY_PORT=18385
# Bearer API、SSE 与 MCP 输出是否脱敏 IMEI/IMSI/本机号码/MAC/WAN 地址与 TAC/CellID 等位置指纹（便于把数据交给云端模型）。
# 登录后的 Web 控制台不受影响：始终收到原值，界面默认打码、点眼睛显示。修改后重启或调用 reset-breaker 生效
REDACT_SENSITIVE_IN_API=true
# SSE 心跳保活间隔（毫秒）与最大并发流连接数
SSE_HEARTBEAT_MS=15000
SSE_MAX_CLIENTS=32

# ==========================================
# ⏱️ 瞬时会话轮询与单管理员避让策略
# ==========================================
# 常规遥测采样间隔（毫秒，默认 5000ms = 5s）
POLL_INTERVAL_MS=5000
# 邻区基站扫描等低频重负载任务间隔（毫秒，默认 60000ms = 60s）
NEIGHBOR_SCAN_INTERVAL_MS=60000
# 单次 HTTP 请求超时（毫秒，默认 15000ms = 15s）
REQUEST_TIMEOUT_MS=15000
# 真人浏览器在线自动避让开关（强烈建议保持 true：检测到 state-login != -1 时主动挂起让位）
# 设为 false 时跳过让位：后台仍会尝试登录，被跨 IP 占用（108003）时读请求报错、写请求返回 502 而非 409
RESPECT_BROWSER_SESSION=true
# 本地加密持久化状态文件路径
STATE_FILE=./data/state.json

# ==========================================
# ✉️ 短信（与遥测共用唯一管理员会话，由 MutexSessionScheduler 统一调度）
# ==========================================
SMS_ENABLED=true
# 国内号码（无国际前缀）的默认国家区号，如 +353 / +86 / +44
DEFAULT_COUNTRY_CODE=+353
# 加密短信镜像与通讯录文件（留空则与 STATE_FILE 同目录：sms.json / contacts.json；同目录下的 sms.json.lock 保证单进程独占）
SMS_FILE=
CONTACTS_FILE=
# 兜底全量对账间隔（毫秒，默认 30 分钟，最小 60000）；新短信由 5s 遥测会话捎带的计数变化即时触发增量同步
SMS_FULL_SYNC_INTERVAL_MS=1800000
# 首次同步时把 CPE 上已有短信视为历史（不推送通知）
SMS_SEED_EXISTING_ON_START=true
# 新短信推送后是否在 CPE 上自动标记已读
SMS_AUTO_MARK_READ=false
# 发送后轮询 send-status 的最长等待（毫秒，5000..120000）
SMS_SEND_STATUS_TIMEOUT_MS=45000

# ==========================================
# 🔔 通知：Telegram 双向机器人与签名 Webhook（仅 serve 守护进程运行）
# ==========================================
# 从 @BotFather 获取（格式 123456789:AA...；留空则不启用机器人）
TELEGRAM_BOT_TOKEN=
# 预授权的聊天 ID（英文逗号分隔，群组为负数）；其他聊天可发送 /auth <API_TOKEN> 绑定（API_TOKEN 轮换后自动解绑）
TELEGRAM_CHAT_IDS=
# 可选：自建 Bot API 服务器
TELEGRAM_API_BASE=https://api.telegram.org
# 加密的 Telegram 状态文件（留空则与 STATE_FILE 同目录：telegram.json）
TELEGRAM_STATE_FILE=
# 可选：新短信与告警以 JSON POST 推送到该地址（如 Home Assistant / n8n）
WEBHOOK_URL=
# 可选：设置后每个请求携带 X-FengSui-Signature: sha256=HMAC(secret, "<X-FengSui-Timestamp>.<body>")
WEBHOOK_SECRET=

# ==========================================
# 🚨 告警引擎（持续窗口 + 迟滞，避免抖动刷屏）
# ==========================================
ALERTS_ENABLED=true
# 推送到 Telegram / Webhook 的最低级别：info | warning | critical（所有告警仍记录于 /api/alerts 与 SSE）
ALERT_NOTIFY_MIN_SEVERITY=warning
# 主制式 RSRP 低于该值或 SINR 低于该值持续 5 分钟触发 SIGNAL_DEGRADED
ALERT_RSRP_THRESHOLD_DBM=-110
ALERT_SINR_THRESHOLD_DB=0

# ==========================================
# 🛠️ WAN 自愈（会在没人操作时写路由器，所以默认关闭；0 = 关闭）
# ==========================================
# 锁频段 / 锁小区后，WAN 必须恢复并连续在线 2 分钟；锁定这么多分钟后仍断开，就自动解除全部锁定一次（3..1440）
LOCK_ROLLBACK_AFTER_MIN=0
# WAN 断开这么多分钟后自动重拨，之后间隔 10 / 30 / 60 分钟再试，24 小时内最多 4 次，从不自动重启（1..1440）
WAN_AUTO_RECONNECT_AFTER_MIN=0

# ==========================================
# 🤖 MCP 短信工具权限（防提示词注入：短信正文一律视为不可信数据）
# ==========================================
# none = 不暴露短信工具；read = 只读（会话列表/详情/状态/通讯录/预览/同步）；full = 追加发送/已读/删除/联系人写入
MCP_SMS_ACCESS=read
# known = 只能发给你保存的通讯录联系人或曾经发过短信的号码（智能体用 upsert_contact 自建的联系人不算）；any = 不限制收件人
MCP_SMS_SEND_POLICY=known
# MCP 每小时最多发送条数（0 = 禁止 MCP 发送）
MCP_SMS_SEND_LIMIT_PER_HOUR=10

# ==========================================
# 🔬 可选：Phase 1 离线审计归档路径（仅探针脚本使用，严禁入库）
# ==========================================
CPE_HAR_PATH=

# ==========================================
# 🐳 docker compose（仅供 compose 变量插值，守护进程不读取）
# ==========================================
# 容器运行用户：填 data/ 目录与本 .env 的属主（群晖 SSH 执行 id -u / id -g，如 1026 / 100）
PUID=1000
PGID=1000
