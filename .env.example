# ==========================================
# 「烽燧」(FengSui / cpe-dash) — H168-383 连接配置
# ==========================================
# 华为 5G CPE Ultra 6 (H168-383) 局域网管理地址（严格限制内网单源 Origin，防 SSRF）
CPE_URL=http://192.168.8.1
# CPE 管理员账号（H168-383 固件 4.4.0.1 默认固定为 admin）
CPE_USERNAME=admin
# CPE 管理后台登录密码（必填；若触发 108006 密码错误将立即触发防爆破断路器熔断）
CPE_PASSWORD=your_cpe_admin_password

# 运行时区（如 UTC、Europe/Dublin、Asia/Shanghai 等）
TZ=UTC

# ==========================================
# 🔐 本地落盘加密与 Web 安全配置
# ==========================================
# 用于本地持久化遥测快照与状态文件（data/*.json）的独立主密钥
# 若留空，默认使用 CPE_PASSWORD 经 scrypt + HKDF-SHA256 派生 AES-256-GCM 子密钥加密落盘
DATA_ENCRYPTION_KEY=

# Web 控制台与 REST API 鉴权口令（留空则默认复用 CPE_PASSWORD，采用常量时间摘要比对）
API_TOKEN=

# 受信任反向代理 IP 或 CIDR 列表（英文逗号分隔，如 127.0.0.1,::1,172.16.0.0/12）
# 仅当直连 Socket 对端命中此白名单时才解析 X-Forwarded-For / X-Forwarded-Proto，严防伪造 IP 绕过限流
TRUSTED_PROXIES=127.0.0.1,::1

# 可选：额外允许访问 Web / MCP 的自定义反代域名白名单（防 DNS Rebinding 攻击，如 cpe.example.com）
ALLOWED_HOSTS=

# ==========================================
# 📡「烽燧」Web 监控台与 MCP Server 监听配置
# ==========================================
WEB_ENABLED=true
# 默认高位独立端口 18384（避开群晖 NAS 常用 8080 及 cpe-sms 默认的 18383）
WEB_PORT=18384
WEB_HOST=0.0.0.0
# 默认界面与广播语言（zh-CN 或 en）
DEFAULT_LOCALE=zh-CN
# 是否在统一端口上暴露 Streamable HTTP POST /mcp 接口供内网 AI 智能体调用
MCP_HTTP_ENABLED=true
# 是否允许 MCP 智能体调用写控制类工具（锁频段/锁小区/安全开关/需 confirm:true 的重启）
MCP_ALLOW_MUTATIONS=true
# API / MCP 输出是否默认对敏感位置指纹（IMEI/IMSI/TAC/CellID）执行脱敏保护
REDACT_SENSITIVE_IN_API=true
# SSE 心跳保活间隔（毫秒）与最大并发流连接数
SSE_HEARTBEAT_MS=15000
SSE_MAX_CLIENTS=32

# ==========================================
# ⏱️ 瞬时会话轮询与单管理员避让策略
# ==========================================
# 常规遥测采样间隔（毫秒，默认 5000ms = 5s）
POLL_INTERVAL_MS=5000
# 邻区基站扫描等低频重负载任务间隔（毫秒，默认 60000ms = 60s）
NEIGHBOR_SCAN_INTERVAL_MS=60000
# 单次 HTTP 请求超时（毫秒，默认 15000ms = 15s）
REQUEST_TIMEOUT_MS=15000
# 真人浏览器在线自动避让开关（强烈建议保持 true：检测到 state-login != -1 时主动挂起让位）
RESPECT_BROWSER_SESSION=true
# 本地加密持久化状态文件路径
STATE_FILE=./data/state.json

# ==========================================
# 🔬 可选：Phase 1 离线审计归档路径（仅探针脚本使用，严禁入库）
# ==========================================
CPE_HAR_PATH=
