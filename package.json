{
  "name": "cpe-dash",
  "version": "1.7.4",
  "private": true,
  "description": "FengSui (烽燧) — Self-hosted strict TypeScript 5G RF telemetry, 3CA carrier aggregation, neighbor cell scanner, band/cell locking, and MCP agent platform for Huawei 5G CPE Ultra 6 (H168-383)",
  "author": "cky008",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cky008/cpe-dash.git"
  },
  "bugs": {
    "url": "https://github.com/cky008/cpe-dash/issues"
  },
  "homepage": "https://github.com/cky008/cpe-dash#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cpe-dash": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "start": "node dist/cli.js serve",
    "dev": "node --experimental-strip-types --watch src/cli.ts serve",
    "mcp": "node --experimental-strip-types src/cli.ts mcp",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.web.json",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "node --experimental-strip-types scripts/build-web.ts",
    "dev:web": "node --experimental-strip-types scripts/build-web.ts --watch",
    "build:docs": "node --experimental-strip-types scripts/build-docs.ts",
    "build:demo": "node --experimental-strip-types scripts/build-web.ts --demo && node --experimental-strip-types scripts/capture-demo-seed.ts dist/demo/demo-seed.json",
    "demo": "node --experimental-strip-types scripts/demo-server.ts",
    "screenshots": "node --experimental-strip-types scripts/screenshots.ts",
    "brand:trace": "node --experimental-strip-types scripts/trace-logo.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:ui": "npm run build:web && node --experimental-strip-types --test test/ui/*.test.ts",
    "test:coverage": "c8 --include='src/**/*.ts' --include='web/src/core/**/*.ts' --include='web/src/demo/**/*.ts' --exclude='web/src/demo/main.ts' --exclude='src/types.ts' --exclude='src/index.ts' --reporter=text --check-coverage --lines 90 --functions 90 --statements 90 node --experimental-strip-types --test test/*.test.ts",
    "audit:secrets": "node --experimental-strip-types scripts/audit-secrets.ts",
    "check": "npm run typecheck && npm run build:web && npm run test:coverage && npm run audit:secrets",
    "probe:har": "node --experimental-strip-types scripts/probe-har-endpoints.ts",
    "probe:locking": "node --experimental-strip-types scripts/probe-locking-algo.ts",
    "probe:rf": "node --experimental-strip-types scripts/probe-rf-ca.ts",
    "probe:neighbors": "node --experimental-strip-types scripts/probe-neighbor-cells.ts",
    "probe:traffic": "node --experimental-strip-types scripts/probe-traffic.ts",
    "probe:topology": "node --experimental-strip-types scripts/probe-topology.ts",
    "probe:session": "node --experimental-strip-types scripts/probe-session-avoidance.ts",
    "probe:extended": "node --experimental-strip-types scripts/probe-extended-capabilities.ts",
    "probe:sms": "node --experimental-strip-types scripts/probe-sms.ts"
  },
  "keywords": [
    "typescript",
    "huawei",
    "5g-cpe",
    "h168-383",
    "telemetry",
    "carrier-aggregation",
    "band-lock",
    "cell-lock",
    "synology",
    "nas"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "@types/node": "^26.6.5",
    "c8": "^12.0.0",
    "daisyui": "^5.7.50",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "test-exclude": {
      "glob": "^14.0.4",
      "minimatch": "^11.0.5"
    }
  }
}
